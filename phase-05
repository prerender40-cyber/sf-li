Invoke-SfStep '05b-retrieve-count' { Get-ChildItem force-app\main\default -Directory | ForEach-Object { "{0} : {1}" -f $_.Name, @(Get-ChildItem $_.FullName -Recurse -File).Count } }

-------------------

Invoke-SfStep '05b-retrieve-count' { Get-ChildItem force-app\main\default -Directory | ForEach-Object { "{0} : {1}" -f $_.Name, @(Get-ChildItem $_.FullName -Recurse -File).Count } }

-------------------

Invoke-SfStep '05c-export-size' { "{0:N0} MB in sf-export" -f ((Get-ChildItem $SfWork\sf-export -Recurse -File | Measure-Object Length -Sum).Sum / 1MB) }

-------------------

Invoke-SfStep '05d-disk-free' { Get-PSDrive C | ForEach-Object { "C: free {0:N0} GB of {1:N0} GB" -f ($_.Free / 1GB), (($_.Used + $_.Free) / 1GB) } }

