Get-ChildItem force-app\main\default\objects -Directory | Where-Object { $_.Name -match '__c$' -and $_.Name -notmatch '^(BMCServiceDesk|CodeBuilder)__' -and $_.Name -gt 'STL_Pending_Payment__c' } | ForEach-Object { "{0} ({1})" -f $_.Name, @(Get-ChildItem (Join-Path $_.FullName 'fields') -File -ErrorAction SilentlyContinue).Count }

